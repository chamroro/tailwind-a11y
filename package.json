{
  "name": "tailwind-contrast-guard",
  "version": "0.1.0",
  "description": "Static analysis tool that catches WCAG contrast violations in Tailwind CSS class combinations (same-element and direct-parent) before they ship.",
  "type": "module",
  "bin": {
    "tw-contrast-guard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["tailwindcss", "accessibility", "a11y", "wcag", "contrast", "lint"],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
