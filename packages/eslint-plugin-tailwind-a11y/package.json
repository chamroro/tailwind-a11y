{
  "name": "eslint-plugin-tailwind-a11y",
  "version": "0.13.1",
  "description": "ESLint rules that catch WCAG accessibility violations — color contrast, touch target size, and focus indicator removal/contrast — in Tailwind CSS class combinations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "tailwindcss",
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "contrast",
    "touch-target",
    "focus-visible"
  ],
  "author": "chamroro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chamroro/tailwind-a11y.git",
    "directory": "packages/eslint-plugin-tailwind-a11y"
  },
  "bugs": {
    "url": "https://github.com/chamroro/tailwind-a11y/issues"
  },
  "homepage": "https://github.com/chamroro/tailwind-a11y/tree/main/packages/eslint-plugin-tailwind-a11y#readme",
  "dependencies": {
    "tailwind-a11y": "^0.13.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
