{
  "name": "tailwind-a11y",
  "version": "0.13.0",
  "description": "Static analysis CLI that catches WCAG accessibility violations — color contrast, touch target size, and focus indicator removal/contrast — in Tailwind CSS class combinations before they ship.",
  "type": "module",
  "bin": {
    "tailwind-a11y": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "tailwindcss",
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "contrast",
    "touch-target",
    "focus-visible",
    "lint"
  ],
  "author": "chamroro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chamroro/tailwind-a11y.git",
    "directory": "packages/tailwind-a11y"
  },
  "bugs": {
    "url": "https://github.com/chamroro/tailwind-a11y/issues"
  },
  "homepage": "https://github.com/chamroro/tailwind-a11y/tree/main/packages/tailwind-a11y#readme",
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
